# ========================================================
# SMART WILDLIFE CONSERVATION & ANTI-POACHING SYSTEM
# Central Environment Variable Template
# ========================================================

# Backend Port and Environment
PORT=5000
NODE_ENV=development

# Neon PostgreSQL Database URL
# Format: postgresql://[user]:[password]@[endpoint].us-east-2.aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:your_neon_password@ep-sample-pool-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Web App Backend API URL
VITE_API_URL=http://localhost:5000/api

# Mobile App Backend API URL
EXPO_PUBLIC_API_URL=http://localhost:5000/api
