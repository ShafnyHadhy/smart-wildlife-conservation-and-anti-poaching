{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "jsx": "react-native",
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "noEmit": true
  },
  "include": [
    "App.tsx",
    "react-native.d.ts"
  ],
  "extends": "expo/tsconfig.base"
}
