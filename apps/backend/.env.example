# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Neon PostgreSQL)
# Neon connection string format:
# postgresql://[user]:[password]@[endpoint].us-east-2.aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:your_neon_password@ep-sample-pool-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Optional explicit connection parameters (used if DATABASE_URL is not set)
DB_HOST=ep-sample-pool-123456.us-east-2.aws.neon.tech
DB_PORT=5432
DB_USER=neondb_owner
DB_PASSWORD=your_neon_password
DB_NAME=neondb
DB_SSL=true

# CORS configuration
CORS_ORIGIN=http://localhost:5173
